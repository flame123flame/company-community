# ───────────────────────────────────────────────────────────────────────────
# AWA ROOM — ตัวแปรสภาพแวดล้อม
#
# คัดลอกเป็น .env.local แล้วเติมค่าจริง  (.env.local ไม่ถูก commit)
# ค่าที่ใช้บน Vercel อยู่ในตารางของ docs/DEPLOY.md
# ───────────────────────────────────────────────────────────────────────────

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# ★ ข้ามทุก RLS — ใช้ฝั่ง server เท่านั้น ห้ามหลุดไปฝั่งเบราว์เซอร์เด็ดขาด
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ── ห้องฟังเพลง ────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXX

# ── งานตามเวลา ─────────────────────────────────────────────────────────────
# สุ่มเอง: openssl rand -hex 32
CRON_SECRET=

# ───────────────────────────────────────────────────────────────────────────
# ★★★ พิกัดออฟฟิศ — เป็น "ค่าตั้งต้น" ไม่ใช่แหล่งความจริง
#
#     แหล่งความจริงคือ app_settings.office_latlng ซึ่ง Admin แก้ได้จาก
#     หน้า /office/admin/settings แล้วระบบคิดระยะทางของทุกร้านใหม่ทันที
#     ★ ตัวแปรสองตัวนี้ถูกใช้เฉพาะตอนที่ยังไม่มีใครตั้งค่านั้น
#       ★★ เก็บไว้ที่ env อย่างเดียวแปลว่าต้อง deploy ใหม่ทุกครั้งที่ย้ายออฟฟิศ
#          และจะมีแหล่งความจริงสองที่ที่ไม่มีอะไรรับประกันว่าตรงกัน
#
#     ตัวอย่างข้างล่างคือหลักกิโลเมตรที่ศูนย์ กรุงเทพฯ
# ───────────────────────────────────────────────────────────────────────────
OFFICE_LAT=13.751944
OFFICE_LNG=100.493889
